# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# SITE key (public half): safe for the browser bundle. Add to .env (git-ignored):
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEziW9iexwXDjZuu

# SECRET key (private half): NEVER put it in .env for the frontend and never
# reference it from src/. Pages Functions reads it from the platform's secret
# store:
#   npx wrangler pages secret put TURNSTILE_SECRET
#   (also: npx wrangler pages secret put TURNSTILE_HOSTNAMES --project-thr... "threatbase.qzz.io")

# Local dev only if you want the widget on localhost:
#   npx wrangler pages dev --binding TURNSTILE_SECRET=... TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Supabase (see src/lib/supabaseConfig.ts for the fallbacks)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
