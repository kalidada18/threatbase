ip2asn-v4.tsv.gz

# Unsplit large feed files — published as GitHub Release assets, never committed.
# They are rewritten in full every run, and committing them as single blobs is
# what burned ~160 MiB of permanent Git LFS storage per run.
#
# Their size-bounded chunks (ioc/domain/threatbase-domain-01.txt, -02.txt, …)
# ARE committed, and are deliberately NOT matched by the two exact paths below.
# Ordinary git deltas them to ~14 KiB per run. See .gitattributes for the story.
ioc/domain/threatbase-domain.txt
ioc/hash/threatbase-hash.txt

# Threatbase Pro products — never committed to this PUBLIC repo. The workflow
# pushes them to the private threatbasepro repo instead, and the only public
# door is /feed/<token>/… (functions/feed/[[path]].ts), which checks is_pro.
# Committing them here is what made the paywall decorative: raw.githubusercontent
# .com served the exact same bytes with no token.
ioc/ip/categories/
ioc/firewall/
ioc/stix/

# API caches
.otx_cache.json
.abuseipdb_cache.txt

